<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Details</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            font-family: "Inter", sans-serif;
        }

        body {
            background: #f3f5f9;
            padding: 40px;
            margin: 0;
        }

        /* Main Card */
        .card {
            max-width: 1100px;
            margin: auto;
            background: white;
            border-radius: 10px;
            padding: 20px 25px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        }

        /* Header Section */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .header h2 {
            color: #2d3748;
            margin: 0;
        }

        .search-add {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .search-box {
            background: #f1f5f9;
            padding: 8px 15px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 14px;
        }

        .add-btn {
            background: #84cc16;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .add-btn:hover {
            background: #65a30d;
        }

        /* Table Styling */
        table {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
        }

        thead {
            background: #4b5563;
            color: white;
        }

        th, td {
            padding: 15px;
            text-align: left;
            font-size: 14px;
        }

        tbody tr {
            border-bottom: 1px solid #e5e7eb;
            transition: background 0.1s;
        }

        tbody tr:hover {
            background: #f9fafb;
        }

        /* Profile Section */
        .profile-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-img {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
        }

        /* Department Tags */
        .tag {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            color: white;
            margin-right: 4px;
            text-transform: uppercase;
        }

        .hr { background: #f43f5e; }
        .sales { background: #f59e0b; }
        .finance { background: #22c55e; }
        .engineer { background: #3b82f6; }

        /* Actions */
        .action-btn {
            text-decoration: none;
            font-size: 16px;
            margin-right: 12px;
            transition: opacity 0.2s;
        }

        .action-btn:hover {
            opacity: 0.7;
        }

        .edit { color: #2563eb; }
        .delete { color: #dc2626; }
    </style>
</head>

<body>

<div class="card">
    <div class="header">
        <h2>Employee Details</h2>
        <div class="search-add">
            <div class="search-box">
                <i class="fa fa-search" style="color: #94a3b8;"></i>
                <input type="text" placeholder="Search...">
            </div>
            <button class="add-btn" onclick="window.location.href='/add'">
                <i class="fa fa-plus"></i> Add User
            </button>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>NAME</th>
                <th>GENDER</th>
                <th>DEPARTMENT</th>
                <th>SALARY</th>
                <th>START DATE</th>
                <th>ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            <% employees.forEach(emp => { %>
                <tr>
                    <td>
                        <div class="profile-container">
                            <img src="https://i.pravatar.cc/150?u=<%= emp.id %>" class="profile-img" alt="profile">
                            <span><%= emp.name %></span>
                        </div>
                    </td>
                    <td><%= emp.gender %></td>
                    <td>
                        <% emp.department.forEach(dept => { %>
                            <span class="tag <%= dept.toLowerCase() %>"><%= dept %></span>
                        <% }); %>
                    </td>
                    <td>₹ <%= emp.salary.toLocaleString('en-IN') %></td>
                    <td><%= emp.startDate %></td>
                    <td>
                        <a href="/edit/<%= emp.id %>" class="action-btn edit" title="Edit">
                            <i class="fa fa-pen"></i>
                        </a>
                        <a href="/delete/<%= emp.id %>" class="action-btn delete" 
                           onclick="return confirm('Are you sure you want to delete this user?')" title="Delete">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
<script>
    // Search input ko select karein
    const searchInput = document.querySelector('.search-box input');

    // Keyup event listen karein (jab user type karega)
    searchInput.addEventListener('keyup', function() {
        const filter = searchInput.value.toLowerCase(); // Jo type kiya use lowercase karein
        const rows = document.querySelectorAll('tbody tr'); // Table ki saari rows lein

        rows.forEach(row => {
            // Row ke andar 'Name' wali column ka text lein
            // Aapke design ke hisaab se ye pehli td ke span mein hai
            const nameElement = row.querySelector('td .profile-container span');
            
            if (nameElement) {
                const nameText = nameElement.textContent.toLowerCase();
                
                // Agar name match hota hai toh dikhayein, nahi toh hide karein
                if (nameText.includes(filter)) {
                    row.style.display = ""; // Show row
                } else {
                    row.style.display = "none"; // Hide row
                }
            }
        });
    });
</script>

</body>
</html>